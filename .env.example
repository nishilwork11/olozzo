# ── Database ────────────────────────────────────────────────
# Postgres connection string (e.g. a Neon database or a Neon dev branch).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth ────────────────────────────────────────────────────
# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the platform (used for payment redirects and webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: serve stores on subdomains, e.g. urban-nest.olozzo.com
# Set to your root domain (e.g. "olozzo.com", or "localhost" for local testing).
NEXT_PUBLIC_ROOT_DOMAIN=""

# ── Payments ────────────────────────────────────────────────
# Stripe: cards, SEPA Direct Debit, iDEAL, Bancontact, Klarna, EPS, Przelewy24…
# (enable the methods you want in the Stripe Dashboard → Payment methods)
# Prefer a restricted key (rk_…) with write access to Checkout Sessions and Refunds and read access to PaymentIntents and Events.
# Test keys (sk_test_/rk_test_) in development and previews; live keys only in production.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint (whsec_…). Locally: the one printed by
#   stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired,charge.refunded,charge.dispute.created --forward-to localhost:3000/api/webhooks/stripe
# Events to enable and setup steps: /admin/payments
STRIPE_WEBHOOK_SECRET=""

# Mollie: popular in NL/BE/DE/FR — iDEAL, Bancontact, SOFORT, cards, PayPal…
MOLLIE_API_KEY=""

# Demo payments let you test the full order flow without any provider: they mark orders paid without
# moving money. Development only — they are always off in production builds and next to a live Stripe key.
# Unset = on locally only when no Stripe/Mollie key is configured.
ENABLE_DEMO_PAYMENTS="false"

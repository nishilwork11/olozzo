# ── Database ────────────────────────────────────────────────
# Postgres connection string (e.g. a Neon database or a Neon dev branch).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth ────────────────────────────────────────────────────
# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the platform (used for payment redirects and webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: serve stores on subdomains, e.g. urban-nest.olozzo.com
# Set to your root domain (e.g. "olozzo.com", or "localhost" for local testing).
NEXT_PUBLIC_ROOT_DOMAIN=""

# ── Payments ────────────────────────────────────────────────
# Stripe: cards, SEPA Direct Debit, iDEAL, Bancontact, Klarna, EPS, Przelewy24…
# (enable the methods you want in the Stripe Dashboard → Payment methods)
# Prefer a restricted key (rk_…) with write access to Checkout Sessions and Refunds and read access to PaymentIntents and Charges.
# Test keys (sk_test_/rk_test_) in development and previews; live keys only in production.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint (whsec_…). Locally: the one printed by
#   stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired,payment_intent.payment_failed,charge.refunded,refund.failed,charge.dispute.created --forward-to localhost:3000/api/webhooks/stripe
# Events to enable and setup steps: /admin/payments
STRIPE_WEBHOOK_SECRET=""
# Safety net for missed webhooks: a scheduler calls GET /api/cron/payments every 15 minutes with
# "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it itself). Generate like AUTH_SECRET.
CRON_SECRET=""

# Mollie: popular in NL/BE/DE/FR — iDEAL, Bancontact, SOFORT, cards, PayPal…
MOLLIE_API_KEY=""

# ── Email ───────────────────────────────────────────────────
# Order confirmations, shipping, refunds and returns to customers, and new orders and alerts to suppliers,
# merchants and admins (src/lib/email/). Sent through Resend: create an API key with "Sending access" and verify
# the sending domain (SPF and DKIM DNS records) in Resend. Without a key, emails are only recorded in
# /admin/emails (status Skipped), where they can be previewed.
RESEND_API_KEY=""
# Sender address on the verified domain, e.g. "orders@olozzo.com". Customer emails show the store's name.
EMAIL_FROM=""
# Optional: where replies go when a store has no support email set
EMAIL_REPLY_TO=""
# Local testing only: send over SMTP instead of Resend, e.g. to Mailpit (inbox at http://localhost:8025):
#   SMTP_URL="smtp://127.0.0.1:1025"   EMAIL_FROM="orders@olozzo.test"
# Leave it unset on the live server, where emails go through Resend.
SMTP_URL=""

# Demo payments let you test the full order flow without any provider: they mark orders paid without
# moving money. Development only — they are always off in production builds and next to a live Stripe key.
# Unset = on locally only when no Stripe/Mollie key is configured.
ENABLE_DEMO_PAYMENTS="false"
